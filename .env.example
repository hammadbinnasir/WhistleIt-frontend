# Copy to .env.local and adjust. Never commit .env files.
# General mock flag for features that still use the legacy mock switch.
# Vite proxies /api to this backend in development to avoid browser CORS preflights.
# Set VITE_API_PROXY_TARGET to the backend origin if VITE_API_BASE_URL is a relative path.
VITE_API_BASE_URL=http://10.0.105.90:8000/api
VITE_USE_MOCKS=true
VITE_CHANNELS_USE_MOCK=true
# Shell uses the real backend by default. Set to 'true' for shell mock data.
VITE_SHELL_USE_MOCK=false
